CC := gcc
TARGET := epuck_robot.exe

SRC := \
  main.c \
  cpu/control.c \
  cpu/datapath.c \
  cpu/cpu.c \
  simulation/simulation.c \
  features/features.c \
  locomotion/locomotion.c \
  sensors/sensors.c \
  sensors/environmental.c \
  sensors/motion.c

OBJ := $(SRC:.c=.o)

WEBOTS_HOME ?= C:/Program Files/Webots
WEBOTS_INCLUDE := $(WEBOTS_HOME)/include/controller/c
WEBOTS_LIB := $(WEBOTS_HOME)/lib/controller

CFLAGS := -std=c11 -Wall -Wextra -Iinclude -I$(WEBOTS_INCLUDE)
LDFLAGS := -L$(WEBOTS_LIB) -lController

all: $(TARGET)

$(TARGET): $(OBJ)
	$(CC) $(OBJ) -o $@ $(LDFLAGS)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

run: $(TARGET)
	./$(TARGET)

clean:
	@del /Q $(OBJ) $(TARGET) 2>nul || exit 0

.PHONY: all run clean
